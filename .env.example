# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Foodics API
FOODICS_API_BASE_URL=https://api.foodics.com/v5
FOODICS_AUTH_BASE_URL=https://api.foodics.com
FOODICS_CLIENT_ID=
FOODICS_CLIENT_SECRET=
FOODICS_REDIRECT_URI=
FOODICS_AUTHORIZATION_CODE=
FOODICS_REFRESH_TOKEN=
FOODICS_ACCESS_TOKEN=
FOODICS_ACCESS_TOKEN_EXPIRES_AT=

# Foodics webhook signature validation
FOODICS_WEBHOOK_SECRET=
FOODICS_WEBHOOK_SIGNATURE_HEADER=x-foodics-signature
FOODICS_WEBHOOK_HASH_ALGO=sha256

# Shipday
SHIPDAY_API_BASE_URL=https://api.shipday.com
SHIPDAY_API_KEY=
SHIPDAY_TIMEOUT_MS=15000
SHIPDAY_MAX_RETRIES=4
SHIPDAY_RETRY_BASE_DELAY_MS=500
SHIPDAY_RETRY_MAX_DELAY_MS=10000

# Optional runtime behavior
FORWARD_EVENTS=order.created,order.updated,order.delivery.created,order.delivery.updated
