{
  "name": "foodics-shipday-webhook",
  "version": "1.0.0",
  "description": "Foodics webhook integration that forwards delivery orders to Shipday",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "start:server": "node src/index.js",
    "start:tunnel": "ngrok http 3000",
    "start:tunnel:npx": "npx ngrok http 3000"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "axios": "^1.8.2",
    "body-parser": "^1.20.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0"
  }
}
